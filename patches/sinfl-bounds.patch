 static void sinfl_refill(struct sinfl *s) {
-	s->bitbuf |= sinfl_read64(s->bitptr) << s->bitcnt;
+	/* STUDIO-PATCH(sinfl-bounds): only the uncompressed-block path checked the end of the input, so on
+	   malformed data the huffman paths refilled from past the end of the buffer, again and again. Past the end
+	   we feed zero bytes instead: bitptr legitimately passes bitend on the last refill of a valid stream, so
+	   only the read has to stay in bounds. Decoding then runs on zeros until it fails or fills the output. */
+	unsigned long long w;
+	if (sinfl_likely(s->bitptr + 8 <= s->bitend)) {
+		w = sinfl_read64(s->bitptr);
+	}
+	else {
+		unsigned char buf[8] = {0};
+		int           avail  = s->bitend > s->bitptr ? (int)(s->bitend - s->bitptr) : 0;
+		int           i;
+		for (i = 0; i < 8 && i < avail; i++) {
+			buf[i] = s->bitptr[i];
+		}
+		w = sinfl_read64(buf);
+	}
+	s->bitbuf |= w << s->bitcnt;
 	s->bitptr += (63 - s->bitcnt) >> 3;
 	s->bitcnt |= 56; /* bitcount in range [56,63] */
 }
