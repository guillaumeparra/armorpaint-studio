# ArmorPaint Studio settings, one VAR=value per line ($VAR and ${VAR} are expanded, "export" and quotes are accepted,
# '…' is taken as is). ArmorPaint reads ~/Library/Application Support/ArmorPaint/studio.env at startup (Linux:
# ~/.local/share/ArmorPaint/studio.env), also when launched from the Finder or the Dock, or the files of $STUDIO_ENV
# (separated by ':'). A real environment variable wins over the files. The startup log lists what was read.

# Python of the Qt windows (texture export, subzero), with PySide6, opencolorio and numpy: setup_python.sh sets it.
#STUDIO_PYTHON='/Users/me/Library/Application Support/ArmorPaint/venv/bin/python'

# Color management: the OCIO configuration (file, .ocioz or ocio:// URI; default: ocio://studio-config-latest), the
# working space of new projects, and the viewport's display transform.
#OCIO=/studio/show/config.ocio
#STUDIO_OCIO_WORKING_SPACE=ACEScg
#STUDIO_OCIO_DISPLAY=sRGB - Display
#STUDIO_OCIO_VIEW=ACES 2.0 - SDR 100 nits (Rec.709)

# Texture export: studio presets (folders or .json files, before the shipped ones), EXR compression.
#STUDIO_EXPORT_PRESETS=/studio/armorpaint/presets
#STUDIO_EXR_COMPRESSION=zip     # none, rle, zips, zip, piz, pxr24, b44, b44a, htj2k256, htj2k32

# ShotGrid: a Python with PySide6 for Toolkit's windows (can be STUDIO_PYTHON's), and tk-core when it is not in
# ShotGrid Desktop's bundle cache.
#STUDIO_SG_PYTHON='/Users/me/Library/Application Support/ArmorPaint/venv/bin/python'
#STUDIO_SGTK_PATH=/studio/shotgrid/tk-core/python

# subzero: sbsrender of Adobe Substance 3D Designer (file, or Designer's folder; default: found in /Applications),
# format of the textures.
#SUBZERO_SBSRENDER='/Applications/Adobe Substance 3D Designer'
#SUBZERO_FORMAT=exr16           # exr16, exr32, png, tga, tif, jpg
#SUBZERO_LIVE=1
