# subzero settings, one VAR=value per line ($VAR and ${VAR} are expanded, "export" and quotes are accepted).
# subzero reads $STUDIO_ENV (one or more files separated by ':'), else the studio.env of ArmorPaint Studio's folder
# (~/Library/Application Support/ArmorPaint/ on macOS, ~/.local/share/ArmorPaint/ on Linux). A real environment
# variable wins over the files. The Settings panel of the window writes its color settings to the first file.

# sbsrender of Adobe Substance 3D Designer (file, or Designer's folder); default: /Applications or /opt/Adobe, then PATH.
#SUBZERO_SBSRENDER=/opt/Adobe/Adobe_Substance_3D_Designer/sbsrender

# Exported materials: <folder>/<Name>/<textures> and subzero.json.
#SUBZERO_EXPORT_DIR=$HOME/subzero
#SUBZERO_EXPORT_TEMPLATE={name}_{channel}
#SUBZERO_FORMAT=exr16          # exr16, exr32, png, tga, tif, jpg
#SUBZERO_EXR_COMPRESSION=none  # none, zip, piz, pxr24, b44
#SUBZERO_SIZE=2048             # unset: 512 in the window, 2048 for subzero render
#SUBZERO_NORMAL_FORMAT=opengl  # or directx
#SUBZERO_LIVE=1                # export again after each change, once exported

# Window: viewer at start, folders of the library browser (one tab each), where the window keeps its settings.
#SUBZERO_VIEWER=1
#SUBZERO_LIBRARY=$HOME/materials:/studio/library/sbsar
#SUBZERO_CONFIG_DIR=$HOME/.config/subzero

# Color (needs opencolorio and numpy): the configuration, and the color space of each map.
#OCIO=ocio://studio-config-latest
#SUBZERO_OCIO_COLOR=sRGB - Texture
#SUBZERO_OCIO_DATA=Raw
#SUBZERO_OCIO_BASECOLOR=ACEScg
#STUDIO_OCIO_DISPLAY=sRGB - Display
#STUDIO_OCIO_VIEW=ACES 2.0 - SDR 100 nits (Rec.709)

# Rendering: sbsrender engine (default: mtl on macOS, sbsrender's choice on Linux; sse2 = CPU) and cache.
#SUBZERO_ENGINE=sse2
#SUBZERO_CACHE=$HOME/.cache/subzero
