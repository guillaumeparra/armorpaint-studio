#!/bin/sh
# subzero launcher (standalone package). Python: $SUBZERO_PYTHON, else the venv made by setup.sh next to this
# package, else $STUDIO_PYTHON (ArmorPaint Studio), else python3 / python from the PATH. In a rez environment
# ($REZ_USED_RESOLVE), the Python of the resolve comes right after $SUBZERO_PYTHON.
# Every argument goes to subzero: subzero --help.
f=$0
while [ -L "$f" ]; do # installed as a symlink (/usr/local/bin/subzero): follow it to the package
	l=$(readlink "$f")
	case $l in
	/*) f=$l ;;
	*) f=$(dirname "$f")/$l ;;
	esac
done
ROOT=$(cd "$(dirname "$f")/.." && pwd)

PY=
if [ -n "${REZ_USED_RESOLVE:-}" ]; then
	CANDIDATES="${SUBZERO_PYTHON:-}"
else
	CANDIDATES="${SUBZERO_PYTHON:-}
$ROOT/venv/bin/python
${STUDIO_PYTHON:-}"
fi
set -f # the list splits on new lines only, without globbing
IFS='
'
for p in $CANDIDATES; do
	if [ -n "$p" ] && [ -x "$p" ]; then
		PY=$p
		break
	fi
done
unset IFS
set +f
if [ -z "$PY" ]; then
	PY=$(command -v python3 || command -v python) || {
		echo "subzero: no Python found: run $ROOT/setup.sh, or set SUBZERO_PYTHON" >&2
		exit 1
	}
fi
PYTHONPATH="$ROOT/python${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -B -m subzero "$@"
