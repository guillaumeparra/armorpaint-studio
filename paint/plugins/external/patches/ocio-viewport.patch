+			sc->texture_units = (tex_unit_t_array_t *)any_array_create(3); // STUDIO-PATCH(ocio-viewport): 3, was 2
 			{
 				tex_unit_t *tu               = (tex_unit_t *)calloc(1, sizeof(tex_unit_t));
 				tu->name                     = "tex";
@@ -3079,6 +3086,12 @@ scene_t *startup_get_scene(void) {
 				tu->link                     = "_lut_tex";
