 			}
+			{ // STUDIO-PATCH(ocio-viewport)
+				tex_unit_t *tu               = (tex_unit_t *)calloc(1, sizeof(tex_unit_t));
+				tu->name                     = "ocio_lut_tex";
+				tu->link                     = "_ocio_lut_tex";
+				sc->texture_units->buffer[2] = tu;
+			}
 			sd->contexts->buffer[0] = sc;
 		}
 		scene->shader_datas->buffer[4] = sd;
