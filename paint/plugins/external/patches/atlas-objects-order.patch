-static i32 tab_meshes_remapped_mask(mesh_object_t **old_order, i32 length, i32 mask) {
-	if (mask < 1 || mask > length) {
+// STUDIO-PATCH(atlas-objects-order): atlases used by the objects, in order of first use (project_get_used_atlases)
+static i32 tab_meshes_used_atlases(i32 *atlas_objects, i32 length, i32 *used) {
+	i32 count = 0;
+	for (i32 i = 0; i < length; ++i) {
+		i32 k = 0;
+		while (k < count && used[k] != atlas_objects[i]) {
+			++k;
+		}
+		if (k == count) {
+			used[count++] = atlas_objects[i];
+		}
+	}
+	return count;
+}
+
+// STUDIO-PATCH(atlas-objects-order): old_length objects in old_order, deleted ones included. A mask on a deleted object
+// or on an atlas no longer used becomes 0. Masks above the object count point into the used atlases (old_used before,
+// new_used after), which the reorder may shuffle.
+static i32 tab_meshes_remapped_mask(mesh_object_t **old_order, i32 old_length, i32 mask, i32 *old_used, i32 old_used_count, i32 *new_used, i32 new_used_count) {
+	i32 length = g_project->_->paint_objects->length;
+	if (mask < 1) {
 		return mask;
 	}
+	if (mask > old_length) {
+		i32 k = mask - old_length - 1;
+		if (old_used_count < 2 || k >= old_used_count) {
+			return mask - old_length + length;
+		}
+		for (i32 i = 0; new_used_count > 1 && i < new_used_count; ++i) {
+			if (new_used[i] == old_used[k]) {
+				return length + 1 + i;
+			}
+		}
+		return 0;
+	}
 	i32 index = array_index_of(g_project->_->paint_objects, old_order[mask - 1]);
-	return index >= 0 ? index + 1 : mask;
+	return index >= 0 ? index + 1 : 0;
 }
 
