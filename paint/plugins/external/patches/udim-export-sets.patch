+// STUDIO-PATCH(udim-export-sets): a layer limited to a texture set has a mask past the objects (project_get_atlas_objects),
+// which upstream read as an object past the end of paint_objects in the per object, per udim tile and selected exports.
+// Objects of the texture set of such a mask; NULL for an object mask, no mask, a set no longer used or sets that no longer
+// match the objects (the layer then paints every object, as in the viewport).
+static mesh_object_t_array_t *export_texture_mask_set_objects(i32 mask) {
+	string_array_t *atlases = project_get_used_atlases();
+	i32             i       = mask - g_project->_->paint_objects->length - 1;
+	if (i < 0 || atlases == NULL || i >= atlases->length || g_project->atlas_objects->length != g_project->_->paint_objects->length) {
+		return NULL;
+	}
+	return project_get_atlas_objects(mask);
+}
+
+static bool export_texture_objects_have(mesh_object_t_array_t *objects, char *name) {
+	for (i32 i = 0; i < objects->length; ++i) {
+		if (string_equals(objects->buffer[i]->base->name, name)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+// STUDIO-PATCH(udim-export-sets): texture set exported per udim tile, its name goes before the channel in the file names
+static char *export_texture_udim_set = NULL;
