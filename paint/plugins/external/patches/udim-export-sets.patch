+// STUDIO-PATCH(udim-export-sets): per udim tile with texture sets (lot D1), the maps of each set for each tile holding one of
+// its objects, "<file>_<set>_<channel>.<tile>". A set gets the layers the Visible export gives it: shared ones, those
+// limited to one of its objects (a tile gets those of its own objects) and those limited to the set. The layer atlas
+// keeps one cell per tile for all the sets: a shared layer gives the same cell to every set of a tile.
+static bool export_texture_layer_in_set(slot_layer_t *l, i32 atlas_index) {
+	i32 mask = slot_layer_get_object_mask(l);
+	if (mask == 0) {
+		return true;
+	}
+	if (mask <= g_project->_->paint_objects->length) {
+		return g_project->atlas_objects->buffer[mask - 1] == atlas_index;
+	}
+	mesh_object_t_array_t *objects = project_get_atlas_objects(mask); // Every object for a set no longer used
+	for (i32 i = 0; i < objects->length; ++i) {
+		if (g_project->atlas_objects->buffer[array_index_of(g_project->_->paint_objects, objects->buffer[i])] == atlas_index) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void export_texture_run_udim_sets(char *path, string_array_t *udim_tiles) {
+	mesh_object_t_array_t *objects = g_project->_->paint_objects;
+	for (i32 atlas_index = 0; atlas_index < g_project->atlas_names->length; ++atlas_index) {
+		slot_layer_t_array_t *layers = any_array_create_from_raw((void *[]){}, 0);
+		for (i32 i = 0; i < g_project->_->layers->length; ++i) {
+			if (export_texture_layer_in_set(g_project->_->layers->buffer[i], atlas_index)) {
+				any_array_push(layers, g_project->_->layers->buffer[i]);
+			}
+		}
+		for (i32 t = 0; t < udim_tiles->length && layers->length > 0; ++t) {
+			bool in_tile = false;
+			for (i32 i = 0; i < objects->length && !in_tile; ++i) {
+				char *name = objects->buffer[i]->base->name;
+				in_tile    = g_project->atlas_objects->buffer[i] == atlas_index && util_mesh_udim_tile(name) >= 0 && ends_with(name, udim_tiles->buffer[t]);
+			}
+			if (in_tile) {
+				export_texture_udim_set = g_project->atlas_names->buffer[atlas_index];
+				export_texture_run_layers(path, layers, udim_tiles->buffer[t], false);
+				export_texture_udim_set = NULL;
+			}
+		}
+	}
+}
