{
	"version": 1,
	"description": "V-Ray VRayMtl, metalness workflow with glossiness (VRayMtl default: Glossiness = 1 - roughness). Colour maps as linear half EXR, data maps raw, height in 32-bit float, OpenGL normals (VRayNormalMap default).",
	"naming": "<file>[_<variant>]_<channel>[.<UDIM>].<ext>",
	"defaults": { "format": "exr", "bits": 16, "color_space": "raw" },
	"textures": [
		{ "name": "Diffuse", "channels": ["base_r", "base_g", "base_b"], "color_space": "linear" },
		{ "name": "Glossiness", "channels": ["smooth"] },
		{ "name": "Metalness", "channels": ["metal"] },
		{ "name": "Normal", "channels": ["nor_r", "nor_g", "nor_b"] },
		{ "name": "Height", "channels": ["height"], "bits": 32 },
		{ "name": "Opacity", "channels": ["opac"] },
		{ "name": "SelfIllumination", "channels": ["base_r * emis", "base_g * emis", "base_b * emis"], "color_space": "linear" }
	]
}
